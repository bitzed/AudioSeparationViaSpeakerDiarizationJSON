# Copy this file to `.env` and fill in real values (the sandbox blocks tools
# from writing .env directly, so create it by hand).

# Zoom Build Platform API credentials (JWT auth)
ZOOM_API_KEY=your_api_key
ZOOM_API_SECRET=your_api_secret

# Optional: override the API base (defaults to https://api.zoom.us/v2)
# ZOOM_API_BASE=https://api.zoom.us/v2

# HTTP Basic auth gate for this PoC (both must be set to enable)
BASIC_AUTH_USER=demo
BASIC_AUTH_PASS=change_me

# Port (Cloud Run injects PORT automatically)
# PORT=8080
